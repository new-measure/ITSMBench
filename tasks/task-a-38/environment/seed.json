  "requests": [
   {
    "id": "4093",
    "issueId": "4093",
    "issueKey": "HELP-4093",
    "serviceDeskId": "1",
    "requestTypeId": "100",
    "currentStatus": {
     "status": "Resolved",
     "statusCategory": "COMPLETE"
    },
    "reporter": {
     "accountId": "cust-lena",
     "displayName": "Lena Brooks",
     "emailAddress": "lena.brooks@northwind-robotics.example"
    },
    "createdDate": {
     "iso8601": "2026-02-10T09:00:00.000Z"
    },
    "requestFieldValues": [
     {
      "fieldId": "summary",
      "label": "Summary",
      "value": "Offboarding - Jonah Weiss (Staff DevOps) - RESOLVED"
     },
     {
      "fieldId": "description",
      "label": "Description",
      "value": "Q1 FY26 offboarding - Jonah Weiss (Staff DevOps Engineer, contract), last day 2026-02-14. RESOLVED / closed. Record of what was done to fully offboard him, kept for reference:\n- SSO: his identity account was deactivated so he can no longer authenticate.\n- Fleet identity: he ALSO had a separate Linux fleet login (used for the build servers) that SSO does not cover; that login was suspended too.\n- Source control: removed from the org. He had wired up CI on the 'checkout-svc' repo - a personal deploy key ('jonah-weiss apply key') and a release webhook he added - both were deleted, since they would otherwise have kept acting after his account was gone.\n- Hardware: the laptop and the security key issued to him were checked back in.\n- On-call: he was the SOLE target of the 'Checkout On-Call' escalation policy. Removing him outright would have left that policy paging no one, so an active SRE was added to the policy first, then he was taken off it.\nConfirmed afterwards that no access, login, deploy key, webhook, on-call slot, or hardware checkout attributable to him remained anywhere."
     }
    ]
   },
   {
    "id": "4127",
    "issueId": "4127",
    "issueKey": "HELP-4127",
    "serviceDeskId": "1",
    "requestTypeId": "100",
    "currentStatus": {
     "status": "Open",
     "statusCategory": "NEW"
    },
    "reporter": {
     "accountId": "cust-lena",
     "displayName": "Lena Brooks",
     "emailAddress": "lena.brooks@northwind-robotics.example"
    },
    "createdDate": {
     "iso8601": "2026-07-15T09:00:00.000Z"
    },
    "requestFieldValues": [
     {
      "fieldId": "summary",
      "label": "Summary",
      "value": "Offboarding batch - platform/DevOps engagements"
     },
     {
      "fieldId": "description",
      "label": "Description",
      "value": "The following platform / DevOps engagements have ended. Please offboard each person and leave the environment in a correct, secure state. Close this request when all are done.\n\n1) Maya Okonkwo - Platform Lead. Built and owned much of the payments platform's CI/CD wiring. Last day 2026-07-10.\n2) Ravi Balan - Build/Release Engineer. Worked across source control and the Linux build fleet. Last day 2026-07-09.\n3) Elena Novak - SRE, Payments. Ran payments reliability and its on-call. Last day 2026-06-30.\n4) Tomas Reyes - DevOps Engineer. Issued company hardware for field work. Last day 2026-07-11.\n5) Nadia Farah - Data Engineer. Data Platform. Last day 2026-07-08.\n6) Sam Levine - Linux Fleet Operator (contractor, never had an SSO account). Managed servers directly. Last day 2026-07-05.\n7) Dana Kessler - Linux Fleet Operator (contractor, never had an SSO account). Ran the build fleet and held issued hardware. Last day 2026-07-06."
     }
    ]
   }
  ]
 }
